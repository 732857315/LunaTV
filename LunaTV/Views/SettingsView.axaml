<UserControl
    x:Class="LunaTV.Views.SettingsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctrls="clr-namespace:LunaTV.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:mic="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:LunaTV.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:SettingsViewModel"
    mc:Ignorable="d">

    <ScrollViewer Padding="20">
        <StackPanel Spacing="8">
            <Grid
                Margin="0,0,0,10"
                ColumnDefinitions="*,Auto"
                RowDefinitions="*,Auto">

                <DockPanel>
                    <Image
                        Height="64"
                        DockPanel.Dock="Left"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/images/tv-navi.png" />

                    <StackPanel Margin="12,0" Spacing="0">
                        <TextBlock
                            Classes="H1"
                            Text="LunaTV"
                            Theme="{StaticResource TitleTextBlock}" />
                        <TextBlock Text="{Binding CurrentVersion}" />

                        <TextBlock Classes="Tertiary" Text="MIT License" />

                        <HyperlinkButton
                            Height="20"
                            Classes="WithIcon Underline"
                            Content="https://github.com/programClown/LunaTV"
                            NavigateUri="https://github.com/programClown/LunaTV" />
                    </StackPanel>
                </DockPanel>


                <DockPanel
                    Name="HeaderRightContent"
                    Grid.Column="1"
                    Opacity="1">
                    <DockPanel.RenderTransform>
                        <TranslateTransform X="0" Y="0" />
                    </DockPanel.RenderTransform>
                    <Image
                        Height="48"
                        DockPanel.Dock="Left"
                        RenderOptions.BitmapInterpolationMode="HighQuality"
                        Source="/Assets/avalonia-logo.ico" />

                    <StackPanel Margin="12,0" VerticalAlignment="Center">
                        <TextBlock
                            Classes="H2"
                            Text="Avalonia"
                            Theme="{StaticResource TitleTextBlock}" />

                        <TextBlock Classes="Tertiary" Text="{Binding CurrentAvaloniaVersion}" />

                        <HyperlinkButton
                            Height="20"
                            Classes="WithIcon Underline"
                            Content="https://github.com/AvaloniaUI/Avalonia"
                            NavigateUri="https://github.com/AvaloniaUI/Avalonia" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <ctrls:OptionsDisplayItem Description="改变主题" Header="主题">
                <ctrls:OptionsDisplayItem.Icon>
                    <mic:MaterialIcon Kind="ThemeLightDark" />
                </ctrls:OptionsDisplayItem.Icon>

                <ctrls:OptionsDisplayItem.Content>
                    <ComboBox
                        MinWidth="150"
                        ItemsSource="{Binding AppThemes}"
                        SelectedItem="{Binding CurrentAppTheme}" />
                </ctrls:OptionsDisplayItem.Content>

            </ctrls:OptionsDisplayItem>

            <ctrls:OptionsDisplayItem Description="改变导航布局" Header="布局">
                <ctrls:OptionsDisplayItem.Icon>
                    <mic:MaterialIcon Kind="AlignHorizontalRight" />
                </ctrls:OptionsDisplayItem.Icon>
                <ctrls:OptionsDisplayItem.Content>
                    <ComboBox
                        MinWidth="150"
                        ItemsSource="{Binding AppFlowDirections}"
                        SelectedItem="{Binding CurrentFlowDirection}" />
                </ctrls:OptionsDisplayItem.Content>

            </ctrls:OptionsDisplayItem>

            <ctrls:OptionsDisplayItem
                Description="系统配色"
                Expands="False"
                Header="主题色"
                IsExpanded="True">

                <ctrls:OptionsDisplayItem.Icon>
                    <mic:MaterialIcon Kind="ColorLens" />
                </ctrls:OptionsDisplayItem.Icon>

                <ctrls:OptionsDisplayItem.Content>
                    <Grid
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        ColumnDefinitions="*,*"
                        RowDefinitions="*,*,*,*">
                        <Border
                            Grid.ColumnSpan="2"
                            Height="40"
                            Background="{DynamicResource SystemAccentColor}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="SystemAccentColor" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="0"
                            Width="90"
                            Height="40"
                            Background="{DynamicResource SystemAccentColorLight1}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Light1" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="0"
                            Width="90"
                            Height="40"
                            Background="{DynamicResource SystemAccentColorLight2}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Light2" />
                        </Border>
                        <Border
                            Grid.Row="3"
                            Grid.Column="0"
                            Width="90"
                            Height="40"
                            Background="{DynamicResource SystemAccentColorLight3}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Light3" />
                        </Border>

                        <Border
                            Grid.Row="1"
                            Grid.Column="1"
                            Width="90"
                            Height="40"
                            Background="{DynamicResource SystemAccentColorDark1}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Dark1" />
                        </Border>
                        <Border
                            Grid.Row="2"
                            Grid.Column="1"
                            Width="90"
                            Height="40"
                            Background="{DynamicResource SystemAccentColorDark2}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Dark2" />
                        </Border>
                        <Border
                            Grid.Row="3"
                            Grid.Column="1"
                            Width="90"
                            Height="40"
                            Background="{DynamicResource SystemAccentColorDark3}">
                            <TextBlock
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
                                Text="Dark3" />
                        </Border>
                    </Grid>
                </ctrls:OptionsDisplayItem.Content>
            </ctrls:OptionsDisplayItem>
        </StackPanel>
    </ScrollViewer>

</UserControl>