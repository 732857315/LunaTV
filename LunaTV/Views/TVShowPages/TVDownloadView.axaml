<UserControl
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:Class="LunaTV.Views.TVShowPages.TVDownloadView"
    x:DataType="vm:TVDownloadViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="using:LunaTV.ViewModels.TVShowPages"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Styles>
        <Style Selector="Button.TransparentButton:pointerover">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
            <Setter Property="RenderTransform" Value="scale(1.01,1.01)" />
        </Style>
        <Style Selector="Button.TransparentButton:pressed">
            <Style Selector="^ /template/ ContentPresenter#PART_ContentPresenter">
                <Setter Property="Background" Value="Transparent" />
            </Style>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto, Auto, *">
        <StackPanel Grid.Row="0" Spacing="8">
            <TextBlock
                FontSize="32"
                Foreground="{DynamicResource SemiPurple6Color}"
                HorizontalAlignment="Center"
                Text="M3U8下载神器"
                Theme="{DynamicResource TitleTextBlock}" />
            <TextBlock
                Classes="H5"
                HorizontalAlignment="Center"
                Text="快速、简单的下载服务  纵享丝滑"
                Theme="{DynamicResource TitleTextBlock}" />

            <Border
                Height="2"
                MaxWidth="600"
                Opacity="0.3">
                <Border.Background>
                    <LinearGradientBrush EndPoint="1,1" StartPoint="0,0">
                        <GradientStop Color="#FFDD9BE0" Offset="0.0" />
                        <GradientStop Color="#FF490A61" Offset="0.5" />
                        <GradientStop Color="#FFB449C2" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <TextBox
                Classes="ClearButton Large"
                Text="{Binding DownloadUrl}"
                Watermark="请输入m3u8链接"
                Width="500">
                <TextBox.InnerRightContent>
                    <Button
                        Classes="Large"
                        Command="{Binding DownloadActionCommand}"
                        Content="下载"
                        Margin="0,0,-10,0" />
                </TextBox.InnerRightContent>
            </TextBox>

        </StackPanel>

        <DockPanel Grid.Row="1" Margin="20,10">
            <TextBlock
                Classes="H6"
                HorizontalAlignment="Left"
                Text="下载管理"
                Theme="{DynamicResource TitleTextBlock}" />

            <!--  92.54% 55.66MB/60.15MB 1.90MBps 00:00:02  -->

            <TextBlock
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Run Text="{Binding Speed}" />
                <Run Text="  " />
                <Run Text="{Binding SizeStr}" />
                <Run Text="  " />
                <Run Text="{Binding RemainingTime}" />
            </TextBlock>

            <TextBlock
                DockPanel.Dock="Right"
                HorizontalAlignment="Right"
                VerticalAlignment="Center">
                <Run Text="下载中:" />
                <Run Foreground="{DynamicResource SemiLime3}" Text="{Binding DownloadingCount}" />
                <Run Text="  等待中：" />
                <Run Foreground="{DynamicResource SemiAmber6}" Text="{Binding WaitingCount}" />
                <Run Text="  总共：" />
                <Run Foreground="{DynamicResource SemiGrey7}" Text="{Binding TotalCount}" />
                <Run FontSize="20" Text="  |  " />
            </TextBlock>
        </DockPanel>

        <DataGrid
            CanUserReorderColumns="True"
            CanUserResizeColumns="True"
            CanUserSortColumns="True"
            Grid.Row="2"
            HeadersVisibility="All"
            IsReadOnly="True"
            ItemsSource="{Binding MediaDownloads}"
            Margin="8">
            <DataGrid.Columns>
                <DataGridTextColumn
                    Binding="{Binding Name}"
                    Header="影视名称"
                    Width="4*"
                    x:DataType="vm:MediaDownloadViewModel" />
                <DataGridTextColumn
                    Binding="{Binding Episode}"
                    Header="剧集"
                    Width="2*"
                    x:DataType="vm:MediaDownloadViewModel" />
                <DataGridTemplateColumn Header="链接" x:DataType="vm:MediaDownloadViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MediaDownloadViewModel">
                            <Button
                                Classes="TransparentButton"
                                Theme="{DynamicResource BorderlessButton}"
                                ToolTip.Tip="{Binding Url}">
                                <PathIcon Data="{DynamicResource SemiIconLink}" Theme="{DynamicResource InnerPathIcon}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn Header="本地路径" x:DataType="vm:MediaDownloadViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MediaDownloadViewModel">
                            <Button
                                Classes="TransparentButton"
                                Command="{Binding OpenFolderCommand}"
                                Theme="{DynamicResource BorderlessButton}"
                                ToolTip.Tip="{Binding LocalPath}">
                                <PathIcon Data="{DynamicResource SemiIconFolderOpen}" Theme="{DynamicResource InnerPathIcon}" />
                            </Button>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Header="操作"
                    Width="2*"
                    x:DataType="vm:MediaDownloadViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MediaDownloadViewModel">
                            <StackPanel
                                Margin="4,4"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Button
                                    Classes="TransparentButton"
                                    Command="{Binding DownloadActionCommand}"
                                    Content="{Binding ActionText}"
                                    Theme="{DynamicResource OutlineButton}" />
                                <Button
                                    Classes="TransparentButton"
                                    Content="删除"
                                    Theme="{DynamicResource OutlineButton}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTemplateColumn
                    Header="状态"
                    Width="3*"
                    x:DataType="vm:MediaDownloadViewModel">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="vm:MediaDownloadViewModel">
                            <StackPanel
                                Margin="8,4"
                                Orientation="Horizontal"
                                Spacing="4">
                                <Label
                                    Classes="Solid"
                                    Classes.Lime="{Binding ActionIndicate}"
                                    Classes.Red="{Binding !ActionIndicate}"
                                    Content="{Binding Status}"
                                    Theme="{StaticResource TagLabel}" />
                                <ProgressBar
                                    IsIndeterminate="{Binding StatusIndicate}"
                                    Maximum="100"
                                    MinWidth="120"
                                    Minimum="0"
                                    ShowProgressText="True"
                                    Value="{Binding Progress}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn
                    Binding="{Binding UpdateTime, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                    Header="下载时间"
                    Width="2*"
                    x:DataType="vm:MediaDownloadViewModel" />
            </DataGrid.Columns>

        </DataGrid>
    </Grid>
</UserControl>