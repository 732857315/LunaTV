<UserControl
    MinWidth="700"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d"
    x:Class="LunaTV.Views.TVShowPages.TVShowAddCustomApiView"
    x:DataType="tvvm:TVShowAddCustomApiViewModel"
    xmlns="https://github.com/avaloniaui"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tvvm="using:LunaTV.ViewModels.TVShowPages"
    xmlns:u="https://irihi.tech/ursa"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid RowDefinitions="Auto,*">
        <StackPanel Spacing="8">
            <TextBlock
                Classes="H3"
                HorizontalAlignment="Center"
                Text="自定义API"
                Theme="{StaticResource TitleTextBlock}" />
            <Expander>
                <Expander.Header>
                    <TextBlock HorizontalAlignment="Center" Text="自定义API格式" />
                </Expander.Header>
                <Expander.Content>
                    <StackPanel Spacing="4">
                        <TextBlock Classes="Small Teriary" Text="LunaTV 支持标准的苹果 CMS V10 API 格式。添加自定义API时需遵循以下格式：" />
                        <TextBlock Classes="Small Teriary" Text="1，API 必须是标准的苹果 CMS V10 API 格式；" />
                        <TextBlock Classes="Small Teriary" Text="2，搜索接口: https://example.com/api.php/provide/vod/?ac=videolist&amp;wd=关键词；" />
                        <TextBlock Classes="Small Teriary" Text="3，搜索接口: 详情接口: `https://example.com/api.php/provide/vod/?ac=detail&amp;ids=视频ID。" />
                    </StackPanel>
                </Expander.Content>
            </Expander>

        </StackPanel>

        <u:Form
            Grid.Row="1"
            HorizontalAlignment="Center"
            LabelPosition="Left"
            LabelWidth="*"
            Width="400">
            <TextBox
                Text="{Binding ApiSource}"
                Watermark="网页域名，如：douban"
                u:FormItem.Label="API源名称（必填）：" />
            <TextBlock
                FontSize="10"
                Foreground="Red"
                IsVisible="{Binding ApiSourceErrorVisible}"
                Text="API源名称不能为空" />
            <TextBox
                Text="{Binding ApiName}"
                Watermark="网站名，如：豆瓣"
                u:FormItem.Label="API名称（必填）：" />
            <TextBlock
                FontSize="10"
                Foreground="Red"
                IsVisible="{Binding ApiNameErrorVisible}"
                Text="API名称不能为空" />
            <TextBox
                InnerLeftContent="https://"
                InnerRightContent=".com"
                Text="{Binding ApiBaseUrl}"
                Watermark="douban"
                u:FormItem.Label="网址（必填）：" />
            <TextBlock
                FontSize="10"
                Foreground="Red"
                IsVisible="{Binding ApiBaseUrlErrorVisible}"
                Text="网址不能为空或非法格式" />
            <TextBox
                InnerLeftContent="https://"
                InnerRightContent=".com"
                Text="{Binding DetailBaseUrl}"
                Watermark="douban"
                u:FormItem.Label="详情页网址：" />
            <CheckBox IsChecked="{Binding IsAdult}" u:FormItem.Label="黄色资源站：">
                <TextBlock Foreground="Yellow" Text="18禁" />
            </CheckBox>
        </u:Form>
    </Grid>
</UserControl>