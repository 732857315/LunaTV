<ResourceDictionary
    xmlns="https://github.com/avaloniaui"
    xmlns:converters="clr-namespace:LunaTV.Converters"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <converters:TimeSpanToDoubleConverter x:Key="TimeSpanToDoubleConverter" />
    <converters:BoundsToPathDataConverter x:Key="BoundsToPathDataConverter" />
    <converters:TimeSpanToMinutesSecondsConverter x:Key="TimeSpanToMinutesSecondsConverter" />

</ResourceDictionary>