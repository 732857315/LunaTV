<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Android mobile-friendly overrides: larger fonts, touch targets, responsive layout -->

    <!-- Global font size increase for readability on mobile -->
    <Style Selector="TextBlock">
        <Setter Property="FontSize" Value="14"/>
    </Style>

    <!-- Buttons need larger touch targets -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>

    <!-- TextBox larger for touch -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontSize" Value="15"/>
    </Style>

    <!-- ScrollViewer should support touch scrolling -->
    <Style Selector="ScrollViewer">
        <Setter Property="AllowAutoHide" Value="False"/>
    </Style>

    <!-- ListBox items need larger touch area -->
    <Style Selector="ListBoxItem">
        <Setter Property="MinHeight" Value="44"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
</Styles>
